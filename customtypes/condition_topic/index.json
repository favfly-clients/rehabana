{
  "format": "page",
  "id": "condition_topic",
  "label": "Condition Topic",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL slug - condition slug, then topic",
          "placeholder": "e.g. parkinsons-disease-caregiver-guide"
        }
      },
      "condition": {
        "type": "Link",
        "config": {
          "label": "Condition this topic belongs to",
          "placeholder": "Pick a Condition",
          "select": "document",
          "customtypes": [
            "condition"
          ],
          "allowTargetBlank": false,
          "allowText": false,
          "repeat": false
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Topic title",
          "placeholder": "e.g. Caregiver Guide"
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Card summary",
          "placeholder": "One sentence shown on the topic card"
        }
      },
      "order": {
        "type": "Number",
        "config": {
          "label": "Order on the condition page",
          "placeholder": "1 shows first"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "hero_section": {
              "type": "SharedSlice"
            },
            "about_section": {
              "type": "SharedSlice"
            },
            "features_section": {
              "type": "SharedSlice"
            },
            "process_section": {
              "type": "SharedSlice"
            },
            "faq_section": {
              "type": "SharedSlice"
            },
            "cta_section": {
              "type": "SharedSlice"
            },
            "testimonial_section": {
              "type": "SharedSlice"
            },
            "team_section": {
              "type": "SharedSlice"
            },
            "gallery_section": {
              "type": "SharedSlice"
            },
            "contact_section": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "Meta Title [40-65 chars]"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "Page Description [70-155 chars]"
        },
        "type": "Text"
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image",
          "constraint": {
            "width": 1200,
            "height": 600
          },
          "thumbnails": [
            {
              "name": "large",
              "width": 1024,
              "height": 524
            },
            {
              "name": "medium",
              "width": 300,
              "height": 150
            },
            {
              "name": "thumbnail",
              "width": 150,
              "height": 150
            }
          ]
        }
      }
    }
  }
}
