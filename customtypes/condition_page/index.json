{
  "format": "page",
  "id": "condition_page",
  "label": "Condition",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL slug",
          "placeholder": "e.g. parkinsons-care (short, unique; becomes one URL segment)"
        }
      },
      "parent": {
        "type": "Link",
        "config": {
          "label": "Parent page (leave empty for a top-level page; max 3 levels deep)",
          "placeholder": "Pick the Condition page this one sits under",
          "select": "document",
          "customtypes": [
            "condition_page"
          ],
          "repeat": false
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "hero_section": {
              "type": "SharedSlice"
            },
            "about_section": {
              "type": "SharedSlice"
            },
            "features_section": {
              "type": "SharedSlice"
            },
            "process_section": {
              "type": "SharedSlice"
            },
            "faq_section": {
              "type": "SharedSlice"
            },
            "cta_section": {
              "type": "SharedSlice"
            },
            "testimonial_section": {
              "type": "SharedSlice"
            },
            "team_section": {
              "type": "SharedSlice"
            },
            "gallery_section": {
              "type": "SharedSlice"
            },
            "contact_section": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "Meta Title [40-65 chars]"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "Page Description [70-155 chars]"
        },
        "type": "Text"
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image",
          "constraint": {
            "width": 1200,
            "height": 600
          },
          "thumbnails": [
            {
              "name": "large",
              "width": 1024,
              "height": 524
            },
            {
              "name": "medium",
              "width": 300,
              "height": 150
            },
            {
              "name": "thumbnail",
              "width": 150,
              "height": 150
            }
          ]
        }
      }
    }
  }
}
