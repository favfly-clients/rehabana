{
  "format": "page",
  "id": "condition",
  "label": "Condition",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL slug",
          "placeholder": "e.g. parkinsons-disease"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Condition name",
          "placeholder": "e.g. Parkinson's Disease"
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Card summary",
          "placeholder": "One sentence shown on the condition card at /conditions"
        }
      },
      "order": {
        "type": "Number",
        "config": {
          "label": "Order on /conditions",
          "placeholder": "1 shows first"
        }
      },
      "local_page": {
        "type": "Link",
        "config": {
          "label": "Kolkata treatment page (the money page this condition sends patients to)",
          "placeholder": "Pick a Service Page",
          "select": "document",
          "customtypes": [
            "custom_page",
            "service_page"
          ],
          "allowTargetBlank": false,
          "allowText": false,
          "repeat": false
        }
      },
      "topics_subheading": {
        "type": "Text",
        "config": {
          "label": "Topics grid - subheading",
          "placeholder": "e.g. Explore"
        }
      },
      "topics_heading": {
        "type": "StructuredText",
        "config": {
          "label": "Topics grid - heading",
          "placeholder": "e.g. Living with Parkinson's",
          "allowTargetBlank": true,
          "single": "heading2"
        }
      },
      "topics_description": {
        "type": "StructuredText",
        "config": {
          "label": "Topics grid - description",
          "placeholder": "One or two lines above the topic cards",
          "allowTargetBlank": true,
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "hero_section": {
              "type": "SharedSlice"
            },
            "about_section": {
              "type": "SharedSlice"
            },
            "features_section": {
              "type": "SharedSlice"
            },
            "process_section": {
              "type": "SharedSlice"
            },
            "faq_section": {
              "type": "SharedSlice"
            },
            "cta_section": {
              "type": "SharedSlice"
            },
            "testimonial_section": {
              "type": "SharedSlice"
            },
            "team_section": {
              "type": "SharedSlice"
            },
            "gallery_section": {
              "type": "SharedSlice"
            },
            "contact_section": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "Meta Title [40-65 chars]"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "Page Description [70-155 chars]"
        },
        "type": "Text"
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image",
          "constraint": {
            "width": 1200,
            "height": 600
          },
          "thumbnails": [
            {
              "name": "large",
              "width": 1024,
              "height": 524
            },
            {
              "name": "medium",
              "width": 300,
              "height": 150
            },
            {
              "name": "thumbnail",
              "width": 150,
              "height": 150
            }
          ]
        }
      }
    }
  }
}
